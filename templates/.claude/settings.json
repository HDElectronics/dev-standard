{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.dev-standard/enforce/hooks/guard-approvals.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.dev-standard/enforce/hooks/require-brainstorm.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.dev-standard/enforce/hooks/require-spec.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.dev-standard/enforce/hooks/no-bypass.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.dev-standard/enforce/hooks/format-file.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.dev-standard/enforce/hooks/definition-of-done.sh", "timeout": 600 }
        ]
      }
    ]
  }
}
